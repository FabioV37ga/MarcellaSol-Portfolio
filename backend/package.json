{
  "name": "marcellasol-portfolio-backend",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "dev:back": "tsx --watch src/server.ts",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "views:validate": "npm run build && node dist/src/scripts/sync-database-views.js --validate-only",
    "views:check": "npm run build && node dist/src/scripts/sync-database-views.js",
    "views:sync": "npm run build && node dist/src/scripts/sync-database-views.js --apply",
    "drive:share-existing": "npm run build && node dist/src/scripts/share-existing-briefing-emails.js",
    "start": "node dist/src/server.js",
    "prod": "npm run build && npm start"
  },
  "author": "Fabio Veiga",
  "license": "ISC",
  "dependencies": {
    "@googleapis/drive": "^21.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.7.0",
    "multer": "^2.2.0",
    "puppeteer": "^25.9.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.3",
    "@types/qrcode": "^1.5.6",
    "parse5": "^8.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "puppeteer@25.9.0": true
  }
}
