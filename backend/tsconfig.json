{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "noEmitOnError": true,
        "noImplicitAny": true,
        "removeComments": true,
        "strictNullChecks": true,
        "allowSyntheticDefaultImports": true,
        "module": "commonjs",
        "target": "ES2020",
        "esModuleInterop": true

    },
    "include": [
        "src/**/*"
    ]
}