{
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "./dist",
        "noEmitOnError": true,
        "noImplicitAny": true,
        "removeComments": true,
        "strictNullChecks": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "types": ["node"],
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "target": "ES2020",
        "esModuleInterop": true

    },
    "include": [
        "src/**/*",
        "test-*.ts"
    ]
}