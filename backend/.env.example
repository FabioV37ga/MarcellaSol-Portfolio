DB_CONNECTION_STRING=mongodb://localhost:27017/marcellasol
NODE_ENV=development
PORT=3000

# Quantidade de proxies reversos confiáveis até o cliente. Use 0 sem proxy e, normalmente, 1 atrás de Nginx/Render.
TRUST_PROXY_HOPS=0

# Segredo aleatório com pelo menos 32 caracteres usado para assinar sessões.
AUTH_TOKEN_SECRET=

# OAuth 2.0 da conta Google proprietária do Drive.
# Uma API key não concede permissão para criar pastas ou enviar arquivos.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_REDIRECT_URI=https://developers.google.com/oauthplayground

# ID da pasta que conterá clientes/{login}/documentos_briefing.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Para conceder leitura das pastas aos e-mails de briefings já enviados:
# npm run drive:share-existing          # somente prévia
# npm run drive:share-existing -- --apply
