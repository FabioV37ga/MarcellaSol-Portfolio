  "view": "<section class=\"proposals-management-container\"><div class=\"page-index\"><a id=\"proposals-clients-index\" class=\"root-index\">Clientes</a><span>›</span><a id=\"proposals-client-index\" class=\"root-index\"><span id=\"proposals-client-name\">Cliente</span></a><span>›</span><p>Etapas &amp; Propostas</p></div><header class=\"proposals-title\"><span class=\"client-management-eyebrow\">Gerenciamento de etapas e propostas</span><h1>Etapas &amp; Propostas de <span id=\"proposals-title-name\">cliente</span></h1><p class=\"proposals-subtitle\">Gerencie as etapas e acompanhe as propostas enviadas para este cliente.</p></header><section class=\"admin-project-progress\" aria-labelledby=\"admin-project-progress-title\"><div class=\"admin-project-progress-heading\"><h2 id=\"admin-project-progress-title\">Etapas do projeto</h2><p data-project-progress-summary>Briefing — aguardando aprovação.</p></div><div class=\"project-progress-scroll\"><div class=\"project-progress-track\" style=\"--steps:7;--current-step:1;--progress:0%\"><span class=\"project-progress-line\" aria-hidden=\"true\"></span><span class=\"project-progress-line-active\" aria-hidden=\"true\"></span><div class=\"project-step project-step-active\" data-stage-key=\"briefing\" data-status=\"awaiting-approval\" aria-current=\"step\"><span class=\"project-step-dot\" aria-hidden=\"true\"></span><span class=\"project-step-label\">Briefing</span><span class=\"project-step-status\" role=\"status\">Aguardando aprovação</span></div><div class=\"project-step\" data-stage-key=\"survey\" data-status=\"not-started\"><span class=\"project-step-dot\" aria-hidden=\"true\"></span><span class=\"project-step-label\">Levantamento</span><span class=\"project-step-status\">Não iniciada</span></div><div class=\"project-step\" data-stage-key=\"layout\" data-status=\"not-started\"><span class=\"project-step-dot\" aria-hidden=\"true\"></span><span class=\"project-step-label\">Layout</span><span class=\"project-step-status\">Não iniciada</span></div><div class=\"project-step\" data-stage-key=\"project-development\" data-status=\"not-started\"><span class=\"project-step-dot\" aria-hidden=\"true\"></span><span class=\"project-step-label\">Desenvolvimento do projeto</span><span class=\"project-step-status\">Não iniciada</span></div><div class=\"project-step\" data-stage-key=\"budgets-definitions\" data-status=\"not-started\"><span class=\"project-step-dot\" aria-hidden=\"true\"></span><span class=\"project-step-label\">Orçamentos e definições</span><span class=\"project-step-status\">Não iniciada</span></div><div class=\"project-step\" data-stage-key=\"executive-project\" data-status=\"not-started\"><span class=\"project-step-dot\" aria-hidden=\"true\"></span><span class=\"project-step-label\">Projeto executivo e detalhamentos</span><span class=\"project-step-status\">Não iniciada</span></div><div class=\"project-step\" data-stage-key=\"final-delivery\" data-status=\"not-started\"><span class=\"project-step-dot\" aria-hidden=\"true\"></span><span class=\"project-step-label\">Entrega final</span><span class=\"project-step-status\">Não iniciada</span></div></div></div></section><div class=\"proposals-columns\"><section class=\"proposals-panel\"><header class=\"proposals-panel-heading\"><h2>Propostas abertas</h2><button id=\"new-proposal\" type=\"button\"><i class=\"fa fa-plus\" aria-hidden=\"true\"></i> Nova proposta</button></header><div id=\"open-proposals-list\" class=\"proposals-list\"></div></section><section class=\"proposals-panel\"><header class=\"proposals-panel-heading\"><h2>Propostas rebatidas</h2></header><div id=\"closed-proposals-list\" class=\"proposals-list\"></div></section></div><span id=\"proposals-feedback\" role=\"status\" aria-live=\"polite\"></span><div class=\"proposals-actions\"><button id=\"proposals-back\" type=\"button\">Voltar ao cliente</button></div><dialog id=\"proposal-dialog\" class=\"proposal-dialog\"><form id=\"proposal-form\" class=\"proposal-dialog-form\"><h2 id=\"proposal-dialog-title\">Nova proposta</h2><label class=\"proposal-field\">Etapa<select id=\"proposal-stage\" name=\"stageKey\" required><option value=\"briefing\">Briefing</option><option value=\"survey\">Levantamento</option><option value=\"layout\">Layout</option><option value=\"project-development\">Desenvolvimento do projeto</option><option value=\"budgets-definitions\">Orçamentos e definições</option><option value=\"executive-project\">Projeto executivo e detalhamentos</option><option value=\"final-delivery\">Entrega final</option></select></label><label class=\"proposal-field\">Título<input id=\"proposal-title\" name=\"title\" type=\"text\" maxlength=\"160\" required></label><label class=\"proposal-field\">Descrição<textarea id=\"proposal-description\" name=\"description\" required></textarea></label><label class=\"proposal-field\">Anexos<input id=\"proposal-attachment\" name=\"attachments\" type=\"file\" multiple></label><small id=\"proposal-current-attachment\"></small><div class=\"proposal-dialog-actions\"><button id=\"proposal-cancel\" type=\"button\">Cancelar</button><button id=\"proposal-save\" type=\"submit\">Salvar proposta</button></div></form></dialog><dialog id=\"proposal-delete-dialog\" class=\"proposal-dialog\"><div class=\"proposal-dialog-form\"><h2>Remover proposta <span id=\"proposal-delete-name\"></span>?</h2><p class=\"proposal-delete-warning\">Ao remover a proposta, os arquivos em anexo também serão removidos do drive, deseja prosseguir?</p><div class=\"proposal-dialog-actions\"><button id=\"proposal-delete-cancel\" type=\"button\">Cancelar</button><button id=\"proposal-delete-confirm\" type=\"button\">Remover proposta</button></div></div></dialog></section>"
